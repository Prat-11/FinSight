# FinSight Environment Configuration
PROJECT_NAME="FinSight Financial Analytics"
API_V1_STR="/api"
SECRET_KEY="finsight-super-secret-jwt-key-please-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default: SQLite (works out of the box)
DATABASE_URL="sqlite:///./finsight.db"

# To switch to PostgreSQL, uncomment the line below:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/finsight"

# CORS Configuration (JSON array format)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# Market Data Cache TTL (in seconds)
CACHE_TTL_SECONDS=300
